# Frontend Configuration
VITE_API_BASE_URL=/api

# Supabase Configuration (Row Level Security protected public client)
# Obtain these from: Supabase Dashboard -> Project Settings -> Data API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Worker / Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
ADMIN_SECRET_KEY=change_me_to_a_secure_token

# Feature Flags
VITE_ENABLE_ANALYTICS=false
